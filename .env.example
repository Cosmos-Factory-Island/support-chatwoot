# =============================================================================
# Chatwoot — Huerto.Bio (support-chatwoot)
# Copiar a `.env` y ajustar por entorno.
# Docs: https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables
# =============================================================================

# --- Obligatorias ---
SECRET_KEY_BASE=replace_with_openssl_rand_hex_64
FRONTEND_URL=https://chat.huerto.bio
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false

# --- Postgres (servicio `postgres`) ---
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DATABASE=chatwoot_production
RAILS_ENV=production
RAILS_MAX_THREADS=5

# --- Redis (servicio `redis`) ---
REDIS_PASSWORD=replace_with_strong_password
REDIS_URL=redis://:replace_with_strong_password@redis:6379

# --- Email ---
# Local (con docker-compose.local.yaml + Mailpit): SMTP_ADDRESS=mailpit, SMTP_PORT=1025
# Producción (Resend u otro):
MAILER_SENDER_EMAIL=Huerto.Bio Soporte <soporte@huerto.bio>
SMTP_DOMAIN=huerto.bio
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_replace_with_resend_api_key
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# --- Almacenamiento y logs ---
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# --- Idioma ---
DEFAULT_LOCALE=es

# =============================================================================
# Desarrollo local (ejemplo — usar con docker-compose.local.yaml)
# =============================================================================
# FRONTEND_URL=https://chatwoot.localhost
# FORCE_SSL=false
# RAILS_ENV=development
# POSTGRES_PASSWORD=chatwoot
# SMTP_ADDRESS=mailpit
# SMTP_PORT=1025
# SMTP_ENABLE_STARTTLS_AUTO=false
# SMTP_OPENSSL_VERIFY_MODE=none
